# =====================================================================
# French Voyage Akademie — variables d'environnement
# Copier en `.env` et renseigner. Ne jamais committer le fichier `.env`.
# =====================================================================

# --- Base de données PostgreSQL ---
POSTGRES_DB=fva
POSTGRES_USER=fva
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_PORT=5432

# --- Backend Spring Boot ---
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
# Clé de signature JWT : au moins 32 caractères aléatoires.
# Générer avec :  openssl rand -base64 48
FVA_JWT_SECRET=change_me_with_a_random_secret_of_at_least_32_chars
# Durée de validité du jeton d'accès, en minutes
FVA_JWT_EXPIRATION_MINUTES=120
# Origines autorisées par CORS, séparées par des virgules
FVA_CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200

# --- Compte administrateur créé au premier démarrage (profil dev uniquement) ---
FVA_ADMIN_EMAIL=admin@frenchvoyage.academy
FVA_ADMIN_PASSWORD=AdminLocal123!

# --- Frontend ---
FRONTEND_PORT=8100

# --- Production (docker-compose.prod.yml) ---
FVA_PUBLIC_DOMAIN=frenchvoyage.academy
FVA_LETSENCRYPT_EMAIL=contact@example.org
