# =====================================================================
# Nginx — production (VPS OVHcloud)
# Variables remplacées au démarrage : ${FVA_PUBLIC_DOMAIN}
# Certificats : volume partagé avec le conteneur certbot.
# =====================================================================

# --- HTTP : validation Let's Encrypt, puis redirection vers HTTPS -----
server {
    listen 80;
    listen [::]:80;
    server_name ${FVA_PUBLIC_DOMAIN} www.${FVA_PUBLIC_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${FVA_PUBLIC_DOMAIN}$request_uri;
    }
}

# --- HTTPS -------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${FVA_PUBLIC_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${FVA_PUBLIC_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FVA_PUBLIC_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/snippets/security-headers.conf;

    root  /usr/share/nginx/html;
    index index.html;

    # Compression : le public visé dispose souvent d'un forfait de données limité.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/json application/javascript
               application/manifest+json image/svg+xml;

    # Limite de débit sur l'authentification : freine le bourrage d'identifiants.
    location ~ ^/api/v1/auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend:8080;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /api/ {
        proxy_pass http://backend:8080;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Estado del servicio (sin detalles): supervisión externa y script de despliegue.
    location = /actuator/health {
        proxy_pass http://backend:8080;
        include /etc/nginx/snippets/proxy.conf;
    }

    # La documentation de l'API reste publique : elle fait partie des livrables.
    location ~ ^/(swagger-ui|v3/api-docs) {
        proxy_pass http://backend:8080;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Le service worker et le manifeste ne doivent jamais être mis en cache
    # par le navigateur, sinon les mises à jour de la PWA restent bloquées.
    location ~ ^/(ngsw\.json|ngsw-worker\.js|manifest\.webmanifest|index\.html)$ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Fichiers compilés avec empreinte dans le nom : cache long et immuable.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|webp|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Routage de l'application monopage : toute URL inconnue renvoie index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
